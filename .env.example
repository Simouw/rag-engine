# ============================================================
# rag-engine configuration
# Copy to .env and fill in the keys for the providers you use.
# Everything has a working default except the LLM settings.
# ============================================================

# --- Server ---
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*
# Optional. When set, every /api route (except /api/health) requires
# either `Authorization: Bearer <key>` or `X-API-Key: <key>`.
RAG_API_KEY=

# --- Database ---
# Zero-config default: SQLite file, no external service needed.
DATABASE_URL=sqlite+aiosqlite:///./data/rag.db
# Production option (requires the pgvector extension):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag
AUTO_CREATE_TABLES=true

# --- Data ---
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=100

# --- Generation LLM (any OpenAI-compatible API) ---
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Groq:        https://api.groq.com/openai/v1
# Ollama:      http://localhost:11434/v1        (LLM_API_KEY can stay empty)
# LM Studio:   http://localhost:1234/v1         (LLM_API_KEY can stay empty)
# Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=90

# --- Embeddings ---
# local  = fastembed ONNX model running on your machine (no API key).
# openai = any OpenAI-compatible /embeddings endpoint.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=./data/models
EMBEDDING_BATCH_SIZE=64
# Only used when EMBEDDING_PROVIDER=openai.
# The dimension must match the model (e.g. 1536 for text-embedding-3-small).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
# Optional asymmetric prefixes, e.g. "passage: " / "query: " for E5 models.
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=2000

# --- Retrieval ---
TOP_K=5
HYBRID_SEARCH=true
CANDIDATES_PER_MODE=20
RERANK_ENABLED=true
RERANK_TOP_N=10
PARENT_CONTEXT_ENABLED=true
# PostgreSQL full-text search configuration (simple, english, french, ...).
FTS_LANGUAGE=simple
